{# _includes/modal-contact.njk — a contact modal instead of a /contact/
   page, same approach as the Saved project's own modal-contact.njk,
   restyled to Pockit's own brand (brand green, rounded cards, Sora/
   Inter) rather than Saved's. Opened by any element carrying
   data-modal-open="modal-contact" (see src/js/custom.js). #}
<div id="modal-contact" class="modal" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="modal-contact-title" inert>
    <div class="modal-content">
        <button type="button" class="modal-close" aria-label="Close contact form">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M2 2l16 16M18 2L2 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
        </button>
        <div class="modal-scroll">
            <div class="form-container">
                <h2 id="modal-contact-title">Get in touch</h2>
                <p class="form-subtitle">Got a question, or just want to say hello? I'll reply.</p>

                <form class="formspree-form" action="https://formspree.io/f/mnpqkaql" method="POST">
                    <div class="form-row">
                        <div class="form-col">
                            <input type="text" name="name" class="form-control" placeholder="Name" required>
                        </div>
                        <div class="form-col">
                            <input type="email" name="email" class="form-control" placeholder="Email address" required>
                        </div>
                    </div>
                    <div class="form-full">
                        <textarea name="message" class="form-control" placeholder="Your message" rows="6" required></textarea>
                    </div>
                    <input type="hidden" name="_subject" value="Message received through pockit.works">
                    <button type="submit" class="hero-cta">Send message</button>
                    <p class="form-note">You're directly contacting <a href="https://ianallannz.github.io" target="_blank" rel="noopener">Ian Allan on the East Coast, New Zealand</a>.</p>
                </form>
            </div>
        </div>
    </div>
</div>
