              <line x1="65" y1="146" x2="175" y2="146" stroke="#ddd" stroke-width="4" stroke-linecap="round"/>
              <circle cx="54" cy="162" r="3" fill="#bbb"/>
              <line x1="65" y1="162" x2="155" y2="162" stroke="#ddd" stroke-width="4" stroke-linecap="round"/>

              <!-- Two overlapping photos. -->
              <rect x="268" y="108" width="92" height="68" rx="4" fill="#f4f4f4" stroke="#e5e5e5" stroke-width="2"/>
              <rect x="248" y="94" width="92" height="68" rx="4" fill="#fff" stroke="#ddd" stroke-width="2"/>
              <circle cx="266" cy="111" r="5" fill="none" stroke="#ccc" stroke-width="2"/>
              <path d="M251 155 L270 136 L283 149 L295 138 L336 158" fill="none" stroke="#ccc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>

              <!-- Banned — half the previous size, solid (no
                   transparency) but the same pale red it read as before. -->
