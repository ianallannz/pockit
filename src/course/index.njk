              <path d="M101 42 L101 68 L110 59 L119 68 L119 42 Z" fill="#ddd" stroke="none"/>
            </g>

            <!-- X, same size as the slide deck's ban circle (r=48). -->
            <line x1="61" y1="86" x2="129" y2="154" stroke="#e8a8a3" stroke-width="12" stroke-linecap="round"/>
            <line x1="61" y1="154" x2="129" y2="86" stroke="#e8a8a3" stroke-width="12" stroke-linecap="round"/>

            <!-- A folder and cards, all the same size, fanned out
                 peeking to the right — same technique as
                 .hero-card-back/.hero-card in the hero above. -->
            <rect x="245" y="46" width="64" height="129" rx="7" fill="#fff" stroke="#ddd" stroke-width="2.3" transform="rotate(11 278 111)"/>
            <rect x="232" y="51" width="64" height="129" rx="7" fill="#fff" stroke="#ddd" stroke-width="2.3" transform="rotate(6 264 115)"/>
